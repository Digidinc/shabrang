[Unit]
Description=Shabrang API Server (GHL Integration)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/shabrang/repo/api
Environment="PATH=/opt/shabrang/repo/api/venv/bin"
ExecStart=/opt/shabrang/repo/api/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 --access-logfile /var/log/shabrang-api/access.log --error-logfile /var/log/shabrang-api/error.log server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
