# Nginx Configuration for landing.shabrang.ca (static landing + variations)
# Copy to /etc/nginx/sites-available/landing.shabrang.ca
# Then: ln -s /etc/nginx/sites-available/landing.shabrang.ca /etc/nginx/sites-enabled/

server {
    listen 80;
    listen [::]:80;
    server_name landing.shabrang.ca;

    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name landing.shabrang.ca;

    # SSL Configuration (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/landing.shabrang.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/landing.shabrang.ca/privkey.pem;

    # Document Root for the landing site (should contain index.html + variations/)
    # Example:
    #   /var/www/landing/index.html
    #   /var/www/landing/variations/realistic/index.html
    #   /var/www/landing/variations/miniature/index.html
    root /var/www/landing;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json;

    # Cache static assets (including Next.js exported assets)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|svg)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Variations: serve real files only (avoid accidentally falling back to the main landing index)
    location ^~ /variations/ {
        try_files $uri $uri/ =404;
    }

    # Main landing: allow SPA-ish fallback to /index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}

