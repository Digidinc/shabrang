# GoHighLevel (GHL) Configuration
# Create a GoHighLevel Marketplace app to obtain these values.
GHL_CLIENT_ID=your_client_id
GHL_CLIENT_SECRET=your_client_secret
GHL_REDIRECT_URI=https://shabrang.ca/api/auth/callback

# Optional: set this after authorizing / selecting a location
GHL_LOCATION_ID=your_location_id

# Optional: override OAuth scopes for quick_auth.py (space-separated)
# GHL_SCOPES=contacts.readonly contacts.write locations.readonly

# Email Settings (optional, used by email_automation.py)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_password

# Social Media (optional)
TWITTER_API_KEY=your_key
INSTAGRAM_ACCESS_TOKEN=your_token
